{
  "manifest_version": 3,
  "name": "Ambient Glow for Video Sites",
  "version": "1.0.0",
  "description": "Adds a soft ambient light glow behind any HTML5 video player, including anime sites.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ambient Glow"
  }
}
