{
  "manifest_version": 3,
  "name": "Ambient Glow for Anime Sites",
  "version": "1.2.0",
  "description": "Adds a soft, colour-matched ambient light glow behind HTML5 video players on anime and other video sites.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ambient Glow"
  },
  "background": {
    "service_worker": "background.js"
  }
}
